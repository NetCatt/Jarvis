# --- 1. LLM & Hybrid STT Configuration ---
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SEC=3.5
GROQ_API_KEY=your_free_groq_api_key
GROQ_STT_TIMEOUT_SEC=4.0
STT_GEMINI_FALLBACK=0
ROUTING_MODE=groq_hybrid
GROQ_BRAIN_MODEL=qwen/qwen3.8-27b
GROQ_BRAIN_FALLBACK=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=high
LOCAL_BRAIN_FIRST=groq_hybrid
LOCAL_BRAIN_PORT=8088
LOCAL_BRAIN_THREADS=4
LOCAL_BRAIN_CTX=4096
LOCAL_BRAIN_REASONING=on
LOCAL_BRAIN_REASONING_BUDGET=1024
LOCAL_BRAIN_MAX_TOKENS=1536
LOCAL_BRAIN_TIMEOUT_SEC=60
DEFAULT_MUSIC_PLATFORM=spotify

# --- 2. Developer Workspace & Project Lead Settings ---
DEFAULT_REPO_PATH=C:/Users/Faisal/Projects/my-active-project
AUTO_WRITE_NEXT_PLAN=true

# --- 3. Live Voice Capture (Adaptive VAD + Hybrid Groq / Moonshine v2 STT) ---
START_ACTIVE=true
OPTIONAL_TOGGLE_KEY_HEX=0x78
STT_ENGINE=hybrid
VAD_MODE=3
VAD_SILENCE_MS=700
VAD_MIN_RMS=650
VAD_ONSET_FRAMES=5
VAD_MIN_SPEECH_FRAMES=12
TTS_ECHO_GUARD_SEC=0.75
ENABLE_BARGE_IN=0
VAD_MAX_DURATION_SEC=12
WAKE_WORDS=mike,ross,hey mike,hey ross
WAKE_GRACE_SEC=30
REQUIRE_WAKE_WORD=true
VOICE_SESSION_ID=voice
STOP_PHRASE=over

# --- 3b. Memory & Agent Dispatch ---
MEMORY_DB_PATH=data/memory.db
SHORT_TERM_TURN_WINDOW=6
MAX_AGENTIC_STEPS=3
CLAUDE_CLI_PATH=
AGENT_DISPATCH_PERMISSION_MODE=acceptEdits
AGENT_DISPATCH_MAX_BUDGET_USD=1.00
AGENT_DISPATCH_TIMEOUT_SEC=180

ASSISTANT_NAME=Mike Ross
ASSISTANT_NICKNAME=Mike
USER_NAME=Fas

# --- 4. Text-to-Speech ---
TTS_ENGINE=fish_audio
TTS_VOICE=ross
FISH_AUDIO_KEY=your_fish_audio_api_key
FISH_AUDIO_MODEL_ID=your_fish_audio_model_id

# --- 5. Google Tasks Configuration ---
GOOGLE_TASKS_LIST_NAME=Daily Agenda
GOOGLE_CREDENTIALS_FILE=data/credentials.json
GOOGLE_TOKEN_FILE=data/token.json

# --- 6. Optional Webhooks & Spotify ---
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
TELEGRAM_CHAT_ID=
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
