# --- 1. LLM Configuration (Google AI Studio Free Tier) ---
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- 2. Developer Workspace & Project Lead Settings ---
DEFAULT_REPO_PATH=C:/Users/Faisal/Projects/my-active-project
AUTO_WRITE_NEXT_PLAN=true

# --- 3. Listening & Voice Verification ("My Voice Only") ---
PICOVOICE_ACCESS_KEY=
VOICE_PROFILE_PATH=faisal.voice
VOICE_MATCH_THRESHOLD=0.65
START_ACTIVE=true
OPTIONAL_TOGGLE_KEY_HEX=0x78

# --- 4. Speech-to-Text & Text-to-Speech ---
STT_MODE=google
TTS_VOICE=en-US-ChristopherNeural

# --- 5. Google Tasks Configuration ---
GOOGLE_TASKS_LIST_NAME=Daily Agenda
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- 6. Webhook Notification (Discord / Slack / Telegram) ---
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
TELEGRAM_CHAT_ID=

# --- 7. Optional Spotify Web API ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
